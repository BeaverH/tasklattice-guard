{
  "schema_version": 1,
  "catalog_version": "security-benchmarks-v2",
  "checked_at": "2026-10-19",
  "scope": "test_tooling_only",
  "tracks": [
    {
      "id": "advbench",
      "name": "AdvBench harmful behaviors",
      "datasets": [
        "advbench"
      ],
      "status": "goal_replay_ready",
      "unit": "harmful_goal",
      "scope": "520 harmful behaviors; not harmful_strings or optimized jailbreak prompts",
      "metrics": [
        "raw_goal_block_rate",
        "execution_error_rate"
      ],
      "limitations": [
        "No native benign controls or official split",
        "Target is a generation prefix, not a safe reference answer"
      ]
    },
    {
      "id": "tdc2023",
      "name": "TDC 2023 Red Teaming Track",
      "datasets": [
        "tdc2023"
      ],
      "status": "goal_replay_ready",
      "unit": "harmful_goal",
      "scope": "50 official dev + 50 official test behaviors",
      "metrics": [
        "raw_goal_block_rate",
        "execution_error_rate"
      ],
      "limitations": [
        "Behaviors are not 50 generated attack cases per behavior",
        "Known lineage/overlap with HarmBench; no native benign controls"
      ]
    },
    {
      "id": "harmbench",
      "name": "HarmBench text behaviors",
      "datasets": [
        "harmbench"
      ],
      "status": "standard_goal_replay_ready",
      "unit": "behavior",
      "scope": "320 test + 80 val: standard 200, contextual 100, copyright 100; text only",
      "metrics": [
        "raw_goal_block_rate_by_functional_category",
        "execution_error_rate"
      ],
      "limitations": [
        "Contextual and copyright records preserved but require dedicated execution/scoring",
        "No images/multimodal, attack generation or official classifier execution in this adapter"
      ]
    },
    {
      "id": "prompt_injection",
      "name": "BIPIA",
      "datasets": [
        "bipia"
      ],
      "status": "paired_scenario_adapter_ready",
      "unit": "context_or_payload_component",
      "scope": "1200 context rows (EmailQA/TableQA/CodeQA) + 250 attack payloads across train/test",
      "metrics": [
        "injection_detection_recall",
        "clean_task_utility",
        "end_to_end_attack_success_rate"
      ],
      "limitations": [
        "Component counts are not composed scenario counts",
        "Scenario adapter preserves task/tool-content boundaries; prompt formatting differs from official system-template runs",
        "WebQA and Summarization require original-source preparation; not included",
        "Model quality requires configured target generation and semantic judge; contract mode leaves ASR null"
      ],
      "scenario_entrypoint": "scripts/evaluate_security_scenarios.py"
    },
    {
      "id": "memory_poisoning",
      "name": "AgentPoison / MINJA",
      "datasets": [
        "agentpoison",
        "minja"
      ],
      "status": "isolated_qa_scenario_adapter_ready",
      "unit": "stateful_episode",
      "scope": "Official references pinned; scenario source lock adds StrategyQA and MMLU QA inputs for isolated direct-write/query-only canary episodes",
      "metrics": [
        "committed_attack_origin_records",
        "attack_origin_retrieval_rate",
        "target_action_success_rate_with_model_judge",
        "clean_task_utility_delta"
      ],
      "limitations": [
        "Direct-write and query-only paths use independent memory per arm, with explicit generation, retrieval, victim session and reset",
        "Fixed QA canary adaptation with lexical retrieval; not the original AgentPoison trigger optimization or MINJA progressive search",
        "Repository license does not replace underlying task/data/model terms",
        "Contract mode verifies workflow only; real model ASR remains unmeasured until target and judge are configured"
      ],
      "scenario_entrypoint": "scripts/evaluate_security_scenarios.py"
    }
  ],
