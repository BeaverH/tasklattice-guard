{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object"
    },
    "service": {
      "type": "object"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string"
        }
      }
    },
    "guard": {
      "type": "object"
    },
    "model": {
      "type": "object",
      "properties": {
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apiBase": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "apiKeyKey": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer"
    },
    "resources": {
      "type": "object"
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object"
        },
        "database": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "bootstrap": {
      "type": "object"
    }
  }
}
